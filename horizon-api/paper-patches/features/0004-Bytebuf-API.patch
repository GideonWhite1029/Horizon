From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GideonWhite1029 <gideonwhite1029@gmail.com>
Date: Fri, 7 Feb 2025 00:23:57 +0300
Subject: [PATCH] Bytebuf API


diff --git a/src/main/java/org/bukkit/Bukkit.java b/src/main/java/org/bukkit/Bukkit.java
index 7a8bc0715cd2c86c7448917c2f9a5ae1884f5fa5..a2c46bd1308155903e36367cb79f539144bf03c4 100644
--- a/src/main/java/org/bukkit/Bukkit.java
+++ b/src/main/java/org/bukkit/Bukkit.java
@@ -3138,4 +3138,19 @@ public final class Bukkit {
         return server.getPhotographerManager();
     }
     // Horizon end - Photographer API
+    // Horizon start - Bytebuf API
+    /**
+     * Gets the BytebufManager instance.
+     * <p>
+     * This method returns the BytebufManager instance from the server.
+     * The BytebufManager is responsible for managing byte buffer-related functionalities
+     * within the Horizon system.
+     * </p>
+     *
+     * @return the BytebufManager instance
+     */
+    public static dev.gideonwhite1029.horizon.bytebuf.BytebufManager getBytebufManager() {
+        return server.getBytebufManager();
+    }
+    // Horizon end - Bytebuf API
 }
diff --git a/src/main/java/org/bukkit/Server.java b/src/main/java/org/bukkit/Server.java
index 4282676f170942332b0d96410a30a14bf6480c24..d750c2f2155e5bddc346c5ffd061b9a2c66ca08b 100644
--- a/src/main/java/org/bukkit/Server.java
+++ b/src/main/java/org/bukkit/Server.java
@@ -2798,4 +2798,17 @@ public interface Server extends PluginMessageRecipient, net.kyori.adventure.audi
      */
     @NotNull dev.gideonwhite1029.horizon.replay.PhotographerManager getPhotographerManager();
     // Horizon end - Photographer API
+    // Horizon start - Bytebuf API
+    /**
+     * Gets the BytebufManager instance.
+     * <p>
+     * This method returns the BytebufManager instance from the server.
+     * The BytebufManager is responsible for managing byte buffer-related functionalities
+     * within the Horizon system.
+     * </p>
+     *
+     * @return the BytebufManager instance
+     */
+    dev.gideonwhite1029.horizon.bytebuf.BytebufManager getBytebufManager();
+    // Horizon end - Bytebuf API
 }
diff --git a/src/main/java/org/bukkit/entity/Player.java b/src/main/java/org/bukkit/entity/Player.java
index ba2be160b5d227a0d82c6d0dc2ab7ef199875fe0..d915b9a4bf277a5625cef712508d6f2864cca46a 100644
--- a/src/main/java/org/bukkit/entity/Player.java
+++ b/src/main/java/org/bukkit/entity/Player.java
@@ -3853,6 +3853,23 @@ public interface Player extends HumanEntity, Conversable, OfflinePlayer, PluginM
     boolean isChunkSent(long chunkKey);
     // Paper end
 
+    // Horizon start - Bytebuf API
+    /**
+     * Sends a packet to the player.
+     *
+     * @param packet the packet to send
+     */
+    void sendPacket(dev.gideonwhite1029.horizon.bytebuf.packet.Packet packet);
+
+    /**
+     * Sends a packet to the player using a Bytebuf and PacketType.
+     *
+     * @param buf the Bytebuf containing the packet data
+     * @param type the type of the packet
+     */
+    void sendPacket(dev.gideonwhite1029.horizon.bytebuf.Bytebuf buf, dev.gideonwhite1029.horizon.bytebuf.packet.PacketType type);
+    // Horizon end - Bytebuf API
+
     @Override
     Spigot spigot();
     // Spigot end
