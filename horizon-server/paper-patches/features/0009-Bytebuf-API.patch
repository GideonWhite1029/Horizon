Subject: [PATCH] Bytebuf API


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 9b4fb44324f8220c76895ae510de20b2d462c04e..da07da31dee104cd4c802f1e96599f314d93b003 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -322,6 +322,7 @@ public final class CraftServer implements Server {
     private final io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler globalRegionScheduler = new io.papermc.paper.threadedregions.scheduler.FoliaGlobalRegionScheduler();
 
     private final dev.gideonwhite1029.horizon.entity.CraftPhotographerManager photographerManager = new dev.gideonwhite1029.horizon.entity.CraftPhotographerManager(); // Horizon - photographer
+    private final dev.gideonwhite1029.horizon.bytebuf.InternalBytebufHandler internalBytebufHandler = new dev.gideonwhite1029.horizon.bytebuf.InternalBytebufHandler(); // Horizon - Bytebuf API
 
     @Override
     public final io.papermc.paper.threadedregions.scheduler.RegionScheduler getRegionScheduler() {
@@ -3412,4 +3413,15 @@ public final class CraftServer implements Server {
         return photographerManager;
     }
     // Horizon end - replay mod api
+
+    // Horizon start - Bytebuf API
+    @Override
+    public dev.gideonwhite1029.horizon.bytebuf.BytebufManager getBytebufManager() {
+        return internalBytebufHandler.getManager();
+    }
+
+    public dev.gideonwhite1029.horizon.bytebuf.InternalBytebufHandler getBytebufHandler() {
+        return internalBytebufHandler;
+    }
+    // Horizon end - Bytebuf API
 }
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index a02f390b0e2fe35557ab3e6401b06e7d73ade5d4..7184adcf90cf73a2c87e7064332a751f9f870a4c 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -3576,6 +3576,18 @@ public class CraftPlayer extends CraftHumanEntity implements Player {
     }
     // Paper end - entity effect API
 
+    // Horizon start - Bytebuf API
+    @Override
+    public void sendPacket(dev.gideonwhite1029.horizon.bytebuf.packet.Packet packet) {
+        this.server.getBytebufHandler().applyPacketToPlayer(this.getHandle(), packet);
+    }
+
+    @Override
+    public void sendPacket(dev.gideonwhite1029.horizon.bytebuf.Bytebuf bytebuf, dev.gideonwhite1029.horizon.bytebuf.packet.PacketType type) {
+        this.server.getBytebufHandler().applyPacketToPlayer(this.getHandle(), new dev.gideonwhite1029.horizon.bytebuf.packet.Packet(type, bytebuf));
+    }
+    // Horizon end - Bytebuf API
+
     @Override
     public @NotNull PlayerGiveResult give(@NotNull final Collection<@NotNull ItemStack> items, final boolean dropIfFull) {
         Preconditions.checkArgument(items != null, "items cannot be null");
