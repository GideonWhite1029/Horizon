Subject: [PATCH] Horizon Protocol Core


diff --git a/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java b/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
index fb263fa1f30a7dfcb7ec2656abfb38e5fe88eac9..d95f9f32ca3367cc8f09b22745b8c47b2fd9a0b9 100644
--- a/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
+++ b/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
@@ -40,13 +40,23 @@ public interface CustomPacketPayload {
 
             @Override
             public void encode(B buffer, CustomPacketPayload value) {
+                // Horizon start - protocol core
+                if (value instanceof dev.gideonwhite1029.horizon.protocol.core.HorizonCustomPayload<?> horizonCustomPayload) {
+                    buffer.writeResourceLocation(horizonCustomPayload.id());
+                    horizonCustomPayload.write(buffer);
+                    return;
+                }
+                // Horizon end - protocol core
                 this.writeCap(buffer, value.type(), value);
             }
 
             @Override
             public CustomPacketPayload decode(B buffer) {
                 ResourceLocation resourceLocation = buffer.readResourceLocation();
-                return (CustomPacketPayload)this.findCodec(resourceLocation).decode(buffer);
+                // Horizon start - protocol core
+                var horizonCustomPayload = dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.decode(resourceLocation, buffer);
+                return java.util.Objects.requireNonNullElseGet(horizonCustomPayload, () -> (CustomPacketPayload) this.findCodec(resourceLocation).decode(buffer));
+                // Horizon end - protocol core
             }
         };
     }
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index b4cbed7c8de3099aa351f5c11c69fd14728ee391..bc02db7c7d20e6d42c4fe36080611b490a1029a8 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1774,6 +1774,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         profilerFiller.popPush("server gui refresh");
 
+        dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handleTick(); // Horizon - protocol
+
         for (int i = 0; i < this.tickables.size(); i++) {
             this.tickables.get(i).run();
         }
diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 14c5ee7ff551a023aaac9205d3b2f55fd3e66b8b..d1c645a8adb8fc12d6417c5f881fde5756dd314b 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -150,6 +150,11 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
 
     @Override
     public void handleCustomPayload(ServerboundCustomPayloadPacket packet) {
+        // Horizon start - protocol
+        if (packet.payload() instanceof dev.gideonwhite1029.horizon.protocol.core.HorizonCustomPayload<?> horizonPayload) {
+            dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handlePayload(player, horizonPayload);
+        }
+        // Horizon end - protocol
         // Paper start
         if (packet.payload() instanceof net.minecraft.network.protocol.common.custom.BrandPayload(String brand)) {
             this.player.clientBrandName = brand;
@@ -209,6 +214,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         final String channel = new String(data, from, length, java.nio.charset.StandardCharsets.US_ASCII);
         if (register) {
             this.getCraftPlayer().addChannel(channel);
+            dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handleMinecraftRegister(channel, player); // Horizon - protocol
         } else {
             this.getCraftPlayer().removeChannel(channel);
         }
