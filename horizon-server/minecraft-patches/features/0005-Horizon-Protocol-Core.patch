@@ -76,6 +77,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         this.pluginMessagerChannels = cookie.channels();
         this.keepAlive = cookie.keepAlive();
         // Paper end
+        this.profile = cookie.gameProfile(); // Horizon - protocol core
     }
 
     // Paper start - configuration phase API
@@ -167,6 +169,17 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
 
     @Override
     public void handleCustomPayload(final ServerboundCustomPayloadPacket packet) {
+        // Horizon start - protocol
+        if (packet.payload() instanceof dev.gideonwhite1029.horizon.protocol.core.HorizonCustomPayload horizonPayload) {
+            dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handlePayload(dev.gideonwhite1029.horizon.protocol.core.ProtocolUtils.createSelector(this), horizonPayload);
+            return;
+        }
+        if (packet.payload() instanceof net.minecraft.network.protocol.common.custom.DiscardedPayload(net.minecraft.resources.Identifier id, byte[] data)) {
+            if (dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handleBytebuf(dev.gideonwhite1029.horizon.protocol.core.ProtocolUtils.createSelector(this), id, io.netty.buffer.Unpooled.wrappedBuffer(data))) {
+                return;
+            }
+        }
+        // Horizon end - protocol
         // Paper start
         if (!(packet.payload() instanceof final net.minecraft.network.protocol.common.custom.DiscardedPayload discardedPayload)) {
             return;
@@ -232,6 +245,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
         final String channel = new String(data, from, length, java.nio.charset.StandardCharsets.US_ASCII);
         if (register) {
             bridge.addChannel(channel);
+            dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handleMinecraftRegister(channel, dev.gideonwhite1029.horizon.protocol.core.ProtocolUtils.createSelector(this)); // Horizon - protocol
         } else {
             bridge.removeChannel(channel);
         }
