diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 9c721d2dcdaddc0b9e196c3a468ebd5b8d70e2e6..95d2dea8046c8cec7db95475d50c129fea73a4b7 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1691,6 +1691,13 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         this.server.spark.tickStart(); // Paper - spark
         new com.destroystokyo.paper.event.server.ServerTickStartEvent(this.tickCount+1).callEvent(); // Paper - Server Tick Events
+
+        // Horizon start - Lag compensation
+        if (dev.gideonwhite1029.horizon.HorizonConfig.tt20LagCompensation) {
+            dev.gideonwhite1029.horizon.util.optimization.LagCompensation.TPSCalculator.onTick();
+        }
+        // Horizon end - Lag Compensation
+
         this.tickCount++;
         this.tickRateManager.tick();
         this.tickChildren(haveTime);
@@ -2951,7 +2958,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
     }
 
     public final java.util.concurrent.ExecutorService chatExecutor = java.util.concurrent.Executors.newCachedThreadPool(
-            new com.google.common.util.concurrent.ThreadFactoryBuilder().setDaemon(true).setNameFormat("Async Chat Thread - #%d").setThreadFactory(HorizonConfig.useVirtualThreadForChatExecutor ? Thread.ofVirtual().factory() : java.util.concurrent.Executors.defaultThreadFactory()).setUncaughtExceptionHandler(new net.minecraft.DefaultUncaughtExceptionHandlerWithName(net.minecraft.server.MinecraftServer.LOGGER)).build()); // Paper // Horizon - Virtual thread for ChatExecutor
+            new com.google.common.util.concurrent.ThreadFactoryBuilder().setDaemon(true).setNameFormat("Async Chat Thread - #%d").setThreadFactory(dev.gideonwhite1029.horizon.HorizonConfig.useVirtualThreadForChatExecutor ? Thread.ofVirtual().factory() : java.util.concurrent.Executors.defaultThreadFactory()).setUncaughtExceptionHandler(new net.minecraft.DefaultUncaughtExceptionHandlerWithName(net.minecraft.server.MinecraftServer.LOGGER)).build()); // Paper // Horizon - Virtual thread for ChatExecutor
     public final ChatDecorator improvedChatDecorator = new io.papermc.paper.adventure.ImprovedChatDecorator(this); // Paper - adventure
 
     public ChatDecorator getChatDecorator() {
diff --git a/net/minecraft/world/level/material/LavaFluid.java b/net/minecraft/world/level/material/LavaFluid.java
index a99bea7ac0610fbf9427568d57c554fd26f35f9d..0a145f0b5984efead50107738e9a62b5895ed2df 100644
--- a/net/minecraft/world/level/material/LavaFluid.java
+++ b/net/minecraft/world/level/material/LavaFluid.java
@@ -191,7 +191,21 @@ public abstract class LavaFluid extends FlowingFluid {
 
     @Override
     public int getTickDelay(final LevelReader level) {
-        return level.getWorldBorder().world != null ? (isFastLava(level) ? level.getWorldBorder().world.purpurConfig.lavaSpeedNether : level.getWorldBorder().world.purpurConfig.lavaSpeedNotNether) : (isFastLava(level) ? 10 : 30); // Purpur - Make lava flow speed configurable
+        // Horizon start - Lag compensation
+        if (dev.gideonwhite1029.horizon.HorizonConfig.tt20LagCompensation && dev.gideonwhite1029.horizon.HorizonConfig.tt20LagCompensationLava) {
+            if (level.getWorldBorder().world != null) {
+                return isFastLava(level)
+                        ? dev.gideonwhite1029.horizon.util.optimization.LagCompensation.tt20(level.getWorldBorder().world.purpurConfig.lavaSpeedNether, true)
+                        : dev.gideonwhite1029.horizon.util.optimization.LagCompensation.tt20(level.getWorldBorder().world.purpurConfig.lavaSpeedNotNether, true); // Horizon
+            } else {
+                return dev.gideonwhite1029.horizon.util.optimization.LagCompensation.tt20(isFastLava(level) ? 10 : 30, true); // default speeds when world is null
+            }
+        } else {
+            return level.getWorldBorder().world != null
+                    ? (isFastLava(level) ? level.getWorldBorder().world.purpurConfig.lavaSpeedNether : level.getWorldBorder().world.purpurConfig.lavaSpeedNotNether)
+                    : (isFastLava(level) ? 10 : 30); // Purpur - Make lava flow speed configurable
+        }
+        // Horizon end - Lag compensation
     }
 
     @Override
diff --git a/net/minecraft/world/level/material/WaterFluid.java b/net/minecraft/world/level/material/WaterFluid.java
index e52362ae20646f0311262853af0cdc690a603b52..c8557bf25e4ed1dcc6887cffd5739edfb9fa4bdd 100644
--- a/net/minecraft/world/level/material/WaterFluid.java
+++ b/net/minecraft/world/level/material/WaterFluid.java
@@ -125,7 +125,13 @@ public abstract class WaterFluid extends FlowingFluid {
 
     @Override
     public int getTickDelay(final LevelReader level) {
-        return 5;
+        // Horizon start - Lag compensation
+        if (dev.gideonwhite1029.horizon.HorizonConfig.tt20LagCompensation && dev.gideonwhite1029.horizon.HorizonConfig.tt20LagCompensationWater) {
+            return dev.gideonwhite1029.horizon.util.optimization.LagCompensation.tt20(5, true);
+        } else {
+            return 5;
+        }
+        // Horizon end - Lag compensation
     }
 
     @Override
