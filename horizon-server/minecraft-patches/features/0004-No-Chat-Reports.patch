     }
 
     public boolean verifyChatTrusted(PlayerChatMessage message) { // Paper - private -> public
-        return message.hasSignature() && !message.hasExpiredServer(Instant.now());
+        return dev.gideonwhite1029.horizon.HorizonConfig.noChatReports || (message.hasSignature() && !message.hasExpiredServer(Instant.now())); // Horizon - No Not Secure
     }
 
     // CraftBukkit start
