diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index bf440407548c6b1ff906c26adcb102f42b3286d5..1630e63d9fe6cc4d0bb844b3607fa7fffbb465c6 100644
