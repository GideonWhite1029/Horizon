diff --git a/net/minecraft/world/level/block/CopperBulbBlock.java b/net/minecraft/world/level/block/CopperBulbBlock.java
index 153af604a49d243bc64ffbbb4e11932f3dfdb373..521fc0f2ac753081a2ed8e2125c797d24ac4d762 100644
--- a/net/minecraft/world/level/block/CopperBulbBlock.java
+++ b/net/minecraft/world/level/block/CopperBulbBlock.java
@@ -33,16 +33,37 @@ public class CopperBulbBlock extends Block {
     @Override
     protected void onPlace(BlockState state, Level level, BlockPos pos, BlockState oldState, boolean movedByPiston) {
         if (oldState.getBlock() != state.getBlock() && level instanceof ServerLevel serverLevel) {
-            this.checkAndFlip(state, serverLevel, pos);
+            // Horizon start - copper bulb 1 gt delay
+            if (!dev.gideonwhite1029.horizon.HorizonConfig.copperBulb1gt) {
+                this.checkAndFlip(state, serverLevel, pos);
+            } else {
+                level.scheduleTick(pos, this, 1);
+            }
+            // Horizon end - copper bulb 1 gt delay
         }
     }
 
     @Override
     protected void neighborChanged(BlockState state, Level level, BlockPos pos, Block neighborBlock, @Nullable Orientation orientation, boolean movedByPiston) {
         if (level instanceof ServerLevel serverLevel) {
-            this.checkAndFlip(state, serverLevel, pos);
+            // Horizon start - copper bulb 1 gt delay
+            if (!dev.gideonwhite1029.horizon.HorizonConfig.copperBulb1gt) {
+                this.checkAndFlip(state, serverLevel, pos);
+            } else {
+                level.scheduleTick(pos, this, 1);
+            }
+            // Horizon end - copper bulb 1 gt delay
+        }
+    }
+
+    // Horizon start - copper bulb 1 gt delay
+    @Override
+    public void tick(BlockState state, ServerLevel level, BlockPos pos, net.minecraft.util.RandomSource random) {
+        if (dev.gideonwhite1029.horizon.HorizonConfig.copperBulb1gt) {
+            checkAndFlip(state, level, pos);
         }
     }
+    // Horizon end - copper bulb 1 gt delay
 
