+++ b/net/minecraft/world/level/block/CopperBulbBlock.java
@@ -33,18 +33,39 @@ public class CopperBulbBlock extends Block {
     @Override
     protected void onPlace(final BlockState state, final Level level, final BlockPos pos, final BlockState oldState, final boolean movedByPiston) {
         if (oldState.getBlock() != state.getBlock() && level instanceof ServerLevel serverLevel) {
-            this.checkAndFlip(state, serverLevel, pos);
+            // Horizon start - copper bulb 1 gt delay
+            if (!dev.gideonwhite1029.horizon.HorizonConfig.copperBulb1gt) {
+                this.checkAndFlip(state, serverLevel, pos);
