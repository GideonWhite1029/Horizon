diff --git a/net/minecraft/world/level/storage/LevelStorageSource.java b/net/minecraft/world/level/storage/LevelStorageSource.java
index 8db7167fab968c9e99211ce95e5d503f9d2eb5f0..219aa0d6d73f314e5f97fed1c709e47777828e0a 100644
--- a/net/minecraft/world/level/storage/LevelStorageSource.java
+++ b/net/minecraft/world/level/storage/LevelStorageSource.java
@@ -579,7 +579,10 @@ public class LevelStorageSource {
             CompoundTag dataTag = levelData.createTag(singleplayerUUID);
             CompoundTag root = new CompoundTag();
             root.put("Data", dataTag);
-            this.saveLevelData(root);
+            // Horizon start - Async playerdata save
+            Runnable runnable = () -> this.saveLevelData(root);
+            dev.gideonwhite1029.horizon.util.AsyncPlayerDataSaving.saveAsync(runnable);
+            // Horizon end - Async playerdata save
         }
 
         public void saveLevelData(final Dynamic<?> tag) {
@@ -673,7 +676,10 @@ public class LevelStorageSource {
             this.checkLock();
             CompoundTag root = LevelStorageSource.readLevelDataTagRaw(this.levelDirectory.dataFile());
             updater.accept(root.getCompoundOrEmpty("Data"));
-            this.saveLevelData(root);
+            // Horizon start - Async playerdata save
+            Runnable runnable = () -> this.saveLevelData(root);
+            dev.gideonwhite1029.horizon.util.AsyncPlayerDataSaving.saveAsync(runnable);
+            // Horizon end - Async playerdata save
         }
 
         public long makeWorldBackup() throws IOException {
diff --git a/net/minecraft/world/level/storage/PlayerDataStorage.java b/net/minecraft/world/level/storage/PlayerDataStorage.java
index eddb6ebe3fa50a818e54079b73ba117be0abd195..1ab4dd2bb91bf1adec71c376ca48676ab4fcf7cc 100644
--- a/net/minecraft/world/level/storage/PlayerDataStorage.java
+++ b/net/minecraft/world/level/storage/PlayerDataStorage.java
@@ -32,6 +32,13 @@ public class PlayerDataStorage {
 
     public void save(final Player player) {
         if (org.spigotmc.SpigotConfig.disablePlayerDataSaving) return; // Spigot
+        // Horizon start - Async playerdata save
+        Runnable runnable = () -> save0(player);
+        dev.gideonwhite1029.horizon.util.AsyncPlayerDataSaving.saveAsync(runnable);
+    }
+
+    private void save0(Player player) {
+        // Horizon end - Async playerdata save
         try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(player.problemPath(), LOGGER)) {
             TagValueOutput output = TagValueOutput.createWithContext(reporter, player.registryAccess());
             player.saveWithoutId(output);
