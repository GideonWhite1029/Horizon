Subject: [PATCH] Horizon Protocol Core


diff --git a/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java b/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
index fb263fa1f30a7dfcb7ec2656abfb38e5fe88eac9..d95f9f32ca3367cc8f09b22745b8c47b2fd9a0b9 100644
--- a/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
+++ b/net/minecraft/network/protocol/common/custom/CustomPacketPayload.java
@@ -40,13 +40,23 @@ public interface CustomPacketPayload {
 
             @Override
             public void encode(B buffer, CustomPacketPayload value) {
+                // Horizon start - protocol core
+                if (value instanceof dev.gideonwhite1029.horizon.protocol.core.HorizonCustomPayload<?> horizonCustomPayload) {
+                    buffer.writeResourceLocation(horizonCustomPayload.id());
+                    horizonCustomPayload.write(buffer);
+                    return;
+                }
+                // Horizon end - protocol core
                 this.writeCap(buffer, value.type(), value);
             }
 
             @Override
             public CustomPacketPayload decode(B buffer) {
                 ResourceLocation resourceLocation = buffer.readResourceLocation();
-                return (CustomPacketPayload)this.findCodec(resourceLocation).decode(buffer);
+                // Horizon start - protocol core
+                var horizonCustomPayload = dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.decode(resourceLocation, buffer);
+                return java.util.Objects.requireNonNullElseGet(horizonCustomPayload, () -> (CustomPacketPayload) this.findCodec(resourceLocation).decode(buffer));
+                // Horizon end - protocol core
             }
         };
     }
