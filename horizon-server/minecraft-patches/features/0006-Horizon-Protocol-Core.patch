+++ b/net/minecraft/server/MinecraftServer.java
@@ -1673,6 +1673,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
 
         profilerFiller.popPush("server gui refresh");
 
+        dev.gideonwhite1029.horizon.protocol.core.HorizonProtocolManager.handleTick(); // Horizon - protocol
+
         for (int i = 0; i < this.tickables.size(); i++) {
             this.tickables.get(i).run();
         }
